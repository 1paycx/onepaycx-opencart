{{ header }}{{ column_left }}
<div id="content">
  <div class="page-header">
    <div class="container-fluid">
      <div class="float-end">
        <button type="submit" form="form-payment" data-bs-toggle="tooltip" title="{{ button_save }}" class="btn btn-primary"><i class="fa-solid fa-save"></i></button>
        <a href="{{ back }}" data-bs-toggle="tooltip" title="{{ button_back }}" class="btn btn-light"><i class="fa-solid fa-reply"></i></a></div>
      <h1>{{ heading_title }}</h1>
      <ol class="breadcrumb">
        {% for breadcrumb in breadcrumbs %}
          <li class="breadcrumb-item"><a href="{{ breadcrumb.href }}">{{ breadcrumb.text }}</a></li>
        {% endfor %}
      </ol>
    </div>
  </div>
  <div class="container-fluid">
    <div class="card">
      <div class="card-header"><i class="fa-solid fa-pencil"></i> {{ text_edit }}</div>
      <div class="card-body">
        <p>{{ text_intro }}</p>
        <div class="alert {% if connected %}alert-success{% else %}alert-warning{% endif %}">{{ text_connection }}</div>
        <form id="form-payment" action="{{ save }}" method="post" data-oc-toggle="ajax">
          <div class="row mb-3">
            <label for="input-api-key" class="col-sm-2 col-form-label">{{ entry_api_key }}</label>
            <div class="col-sm-10">
              <input type="password" name="payment_onepaycx_api_key" value="" placeholder="pk_xxx.yyy" id="input-api-key" class="form-control" autocomplete="new-password"/>
              <div class="form-text">{{ help_api_key }}</div>
              <div id="error-api-key" class="invalid-feedback"></div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-title" class="col-sm-2 col-form-label">{{ entry_title }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_onepaycx_title" value="{{ payment_onepaycx_title }}" placeholder="{{ entry_title }}" id="input-title" class="form-control"/>
              <div class="form-text">{{ help_title }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-order-status" class="col-sm-2 col-form-label">{{ entry_order_status }}</label>
            <div class="col-sm-10">
              <select name="payment_onepaycx_order_status_id" id="input-order-status" class="form-select">
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_onepaycx_order_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ help_order_status }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-pending-status" class="col-sm-2 col-form-label">{{ entry_pending_status }}</label>
            <div class="col-sm-10">
              <select name="payment_onepaycx_pending_status_id" id="input-pending-status" class="form-select">
                <option value="0"{% if not payment_onepaycx_pending_status_id %} selected{% endif %}>{{ text_leave_missing }}</option>
                {% for order_status in order_statuses %}
                  <option value="{{ order_status.order_status_id }}"{% if order_status.order_status_id == payment_onepaycx_pending_status_id %} selected{% endif %}>{{ order_status.name }}</option>
                {% endfor %}
              </select>
              <div class="form-text">{{ help_pending_status }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_direct }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_onepaycx_direct" value="0"/>
                <input type="checkbox" name="payment_onepaycx_direct" value="1" id="input-direct" class="form-check-input"{% if payment_onepaycx_direct %} checked{% endif %}/>
              </div>
              <div class="form-text">{{ help_direct }}</div>
            </div>
          </div>
          <div class="row mb-3">
            <label class="col-sm-2 col-form-label">{{ entry_status }}</label>
            <div class="col-sm-10">
              <div class="form-check form-switch form-switch-lg">
                <input type="hidden" name="payment_onepaycx_status" value="0"/>
                <input type="checkbox" name="payment_onepaycx_status" value="1" id="input-status" class="form-check-input"{% if payment_onepaycx_status %} checked{% endif %}/>
              </div>
            </div>
          </div>
          <div class="row mb-3">
            <label for="input-sort-order" class="col-sm-2 col-form-label">{{ entry_sort_order }}</label>
            <div class="col-sm-10">
              <input type="text" name="payment_onepaycx_sort_order" value="{{ payment_onepaycx_sort_order }}" placeholder="{{ entry_sort_order }}" id="input-sort-order" class="form-control"/>
            </div>
          </div>
        </form>
        {% if callback_url %}
          <hr/>
          <p class="mb-1">{{ text_callback_url }} <code>{{ callback_url }}</code></p>
          <p class="form-text">{{ help_callback_url }}</p>
        {% endif %}
        {% if reconcile_url %}
          <p class="mb-1">{{ text_reconcile_url }} <code>{{ reconcile_url }}</code></p>
          <p class="form-text">{{ help_reconcile_url }}</p>
        {% endif %}
      </div>
    </div>
  </div>
</div>
{{ footer }}
